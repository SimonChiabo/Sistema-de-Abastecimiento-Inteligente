# ---------------------------------------------------------------------------
# SAI - Plantilla de variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.
# ---------------------------------------------------------------------------

# --- Google Sheets API ---
# Ruta al JSON de la cuenta de servicio de GCP (Sheets API + Drive API habilitadas).
CREDENTIALS_PATH=credentials.json
# Nombre del spreadsheet maestro (MASTER_SKU / MASTER_PROV).
MASTER_SPREADSHEET_NAME=SAI - Sistema de Abastecimiento
# Prefijo que identifica los spreadsheets de cada local.
LOCAL_PREFIX=SAI_Local_

# --- Base de datos ---
DB_URL=sqlite:///sai_local.db

# --- Notificaciones por correo ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@ejemplo.com
# Contraseña de aplicación, no la contraseña de la cuenta.
SMTP_PASS=
# Destinatario de los reportes de auditoría.
ADMIN_EMAIL=tu-cuenta@ejemplo.com

# --- Sincronizacion con deposito central (opcional) ---
WAREHOUSE_SYNC_ENABLED=false
WAREHOUSE_SPREADSHEET_ID=
